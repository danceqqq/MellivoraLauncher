<Application x:Class="PomogatorLauncher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgDeep" Color="#1D1D1D"/>
        <SolidColorBrush x:Key="BgCard" Color="#2A2A2A"/>
        <SolidColorBrush x:Key="Accent" Color="#E0015B"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F7F7F7"/>
        <SolidColorBrush x:Key="TextMuted" Color="#A8A8A8"/>

        <Style x:Key="LaunchTile" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Белое свечение по контуру карточки -->
                            <Border x:Name="GlowHost"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="14"
                                    Margin="-1"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="WhiteGlow"
                                                      BlurRadius="0"
                                                      ShadowDepth="0"
                                                      Color="White"
                                                      Opacity="0"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="bd"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="14"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#353030"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard Name="GlowPulseStoryboard">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="WhiteGlow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             From="14" To="32" Duration="0:0:1.15"
                                                             AutoReverse="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="WhiteGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.38" To="0.92" Duration="0:0:1.15"
                                                             AutoReverse="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="GlowPulseStoryboard"/>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="WhiteGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.42">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="WhiteGlow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="0" Duration="0:0:0.42">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2528"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Плитка Shazam: без квадратного свечения карточки; белый неон по контуру SVG -->
        <Style x:Key="LaunchTileShazam" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BgCard}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.4" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                <Border x:Name="ShazamIconNeonHost"
                                        Width="48" Height="48"
                                        Margin="0,0,0,10"
                                        HorizontalAlignment="Left"
                                        Background="Transparent">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="SvgNeonGlow"
                                                          BlurRadius="0"
                                                          ShadowDepth="0"
                                                          Color="White"
                                                          Opacity="0"/>
                                    </Border.Effect>
                                    <svgc:SvgViewbox Stretch="Uniform"
                                                      Source="pack://application:,,,/svg/shazam.svg"/>
                                </Border>
                                <TextBlock Text="Поиск Музыки Shazam"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#353030"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard Name="ShazamSvgNeonStoryboard">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="SvgNeonGlow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             From="8" To="22" Duration="0:0:1.2"
                                                             AutoReverse="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SvgNeonGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.5" To="1" Duration="0:0:1.2"
                                                             AutoReverse="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="ShazamSvgNeonStoryboard"/>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="SvgNeonGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="SvgNeonGlow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             To="0" Duration="0:0:0.35">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#2A2528"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
