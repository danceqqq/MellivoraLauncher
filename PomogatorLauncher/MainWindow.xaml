                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#FFF7F7F7"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16,8,16,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border x:Name="ShazamResultPanel"
                        Grid.Row="0"
                        Visibility="Collapsed"
                        Background="#3300D4FF"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="96" Height="96" CornerRadius="8" ClipToBounds="True" Background="#FF1A1A1A">
                            <Image x:Name="ShazamHeroCover" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="ShazamHeroTitle" FontSize="18" FontWeight="Bold" Foreground="#FFE0015B" TextWrapping="Wrap"/>
                            <TextBlock x:Name="ShazamHeroArtist" FontSize="14" Foreground="#FFF7F7F7" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center">
                    <Grid x:Name="ShazamPulseHost" Width="260" Height="260">
                        <Grid.Resources>
                            <Storyboard x:Key="ShazamPulseStoryboard" RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="ShazamRingA"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.62" To="1.18" Duration="0:0:1.35" AutoReverse="True">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ShazamRingA"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.62" To="1.18" Duration="0:0:1.35" AutoReverse="True">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ShazamRingB"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                 From="0.62" To="1.18" Duration="0:0:1.35" AutoReverse="True"
                                                 BeginTime="0:0:0.45">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ShazamRingB"
                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                 From="0.62" To="1.18" Duration="0:0:1.35" AutoReverse="True"
                                                 BeginTime="0:0:0.45">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ShazamRingA"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0.65" To="0.18" Duration="0:0:1.35" AutoReverse="True">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ShazamRingB"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0.5" To="0.12" Duration="0:0:1.35" AutoReverse="True"
                                                 BeginTime="0:0:0.45">
                                    <DoubleAnimation.EasingFunction>
                                        <SineEase EasingMode="EaseInOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </Grid.Resources>

                        <Ellipse x:Name="ShazamRingA"
                                 Width="220" Height="220"
                                 Fill="#35FFFFFF"
                                 Opacity="0.55"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="0.62" ScaleY="0.62"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse x:Name="ShazamRingB"
                                 Width="220" Height="220"
                                 Fill="#28FFFFFF"
                                 Opacity="0.45"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsHitTestVisible="False"
                                 RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform ScaleX="0.62" ScaleY="0.62"/>
                            </Ellipse.RenderTransform>
                        </Ellipse>

