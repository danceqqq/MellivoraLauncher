                            Background="Transparent"
                            BorderBrush="#FF3D3D3D"
                            BorderThickness="1">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#FFE0015B"
