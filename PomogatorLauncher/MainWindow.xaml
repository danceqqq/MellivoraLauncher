<Window x:Class="PomogatorLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PomogatorLauncher"
        xmlns:svgc="clr-namespace:SharpVectors.Converters;assembly=SharpVectors.Converters.Wpf"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Помогатор"
        Height="600" Width="740"
        MinHeight="500" MinWidth="560"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Background="#FF1D1D1D"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        StateChanged="MainWindow_StateChanged">
    <Window.Resources>
        <Storyboard x:Key="StatusPingStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="StatusPingEllipse"
                             Storyboard.TargetProperty="Opacity"
                             From="0.55" To="0" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StatusPingScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1" To="2.7" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StatusPingScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1" To="2.7" Duration="0:0:1.1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Style x:Key="ShazamRecordButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                            <Border x:Name="RecSvgNeonHost" Background="Transparent">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="RecSvgNeonGlow"
                                                      Color="White"
                                                      BlurRadius="0"
                                                      ShadowDepth="0"
                                                      Opacity="0"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard Name="RecNeonSb">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="RecSvgNeonGlow"
                                                             Storyboard.TargetProperty="BlurRadius"
                                                             From="10" To="26" Duration="0:0:1.15" AutoReverse="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="RecSvgNeonGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0.55" To="1" Duration="0:0:1.15" AutoReverse="True">
                                                <DoubleAnimation.EasingFunction>
                                                    <SineEase EasingMode="EaseInOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="RecNeonSb"/>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="RecSvgNeonGlow"
                                                             Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3"/>
                                            <DoubleAnimation Storyboard.TargetName="RecSvgNeonGlow"
                                                             Storyboard.TargetProperty="BlurRadius" To="0" Duration="0:0:0.3"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="RecSvgNeonHost" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MellivoraComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFE0015B"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44E0015B"/>
                                <Setter Property="Foreground" Value="#FFF7F7F7"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55E0015B"/>
                                <Setter Property="Foreground" Value="#FFF7F7F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MellivoraSettingsComboBox" TargetType="ComboBox">
            <Style.Resources>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#FF252525"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#FFE0015B"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FF2A2A2A"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#FFE0015B"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#66E0015B"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFF7F7F7"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#FF252525"/>
                <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#FFE0015B"/>
            </Style.Resources>
            <Setter Property="Background" Value="#FF2A2A2A"/>
            <Setter Property="Foreground" Value="#FFE0015B"/>
            <Setter Property="BorderBrush" Value="#FF3D3D3D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource MellivoraComboBoxItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="MainGrid" SnapsToDevicePixels="True">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"/>
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press"/>
                            <ContentPresenter x:Name="ContentSite"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              IsHitTestVisible="False"/>
                            <Path HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Data="M 0 0 L 4 4 L 8 0 Z"
                                  Fill="#FFE0015B"
                                  Stretch="Uniform"
                                  Width="10"
                                  Height="6"
                                  IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, ElementName=MainGrid}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#FF252525"
                                        BorderBrush="#FF3D3D3D"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        Margin="0,2,0,0">
                                    <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"
                                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#88E0015B"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#66E0015B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#FF6B7280"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScriptsExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <DockPanel>
                                <ToggleButton x:Name="ExpanderHeaderSite"
                                              DockPanel.Dock="Top"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Cursor="Hand"
                                              HorizontalContentAlignment="Stretch"
                                              VerticalContentAlignment="Center"
                                              Padding="{TemplateBinding Padding}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter Grid.Column="0"
                                                          RecognizesAccessKey="True"
                                                          ContentSource="Header"
                                                          HorizontalAlignment="Stretch"
                                                          VerticalAlignment="Center"/>
                                        <Grid Grid.Column="1"
                                              Width="22"
                                              Height="22"
                                              Margin="10,0,0,0"
                                              VerticalAlignment="Center">
                                            <svgc:SvgViewbox x:Name="ArrowDownGlyph"
                                                             Stretch="Uniform"
                                                             Source="pack://application:,,,/svg/arrowdown.svg"
                                                             Visibility="Visible"/>
                                            <svgc:SvgViewbox x:Name="ArrowUpGlyph"
                                                             Stretch="Uniform"
                                                             Source="pack://application:,,,/svg/arrowup.svg"
                                                             Visibility="Collapsed"/>
                                        </Grid>
                                    </Grid>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite"
                                                  DockPanel.Dock="Bottom"
                                                  Focusable="False"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  Margin="0,6,0,0"
                                                  Visibility="Collapsed"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ArrowDownGlyph" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ArrowUpGlyph" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ShazamMarqueeCardTemplate" DataType="{x:Type local:ShazamTrackViewModel}">
            <Border Width="268" Margin="0,0,16,0" Background="#332A2A2A" CornerRadius="10" Padding="8" VerticalAlignment="Center">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" CornerRadius="8" ClipToBounds="True" Background="#FF2A2A2A">
                        <Image Source="{Binding Cover}" Stretch="UniformToFill"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#FFE0015B" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Artist}" Foreground="#FFF7F7F7" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <!-- WebView2 в Border с Opacity: у самого WebView2 Opacity read-only -->
        <Border Width="96" Height="96"
                Opacity="0.015"
                VerticalAlignment="Bottom" HorizontalAlignment="Left"
                Margin="-80,0,0,-80"
                IsHitTestVisible="False"
                ClipToBounds="True"
                SnapsToDevicePixels="True">
            <wv2:WebView2 x:Name="MonitorWebView"
                          Visibility="Visible"
                          IsHitTestVisible="False"/>
        </Border>
        <Border x:Name="AnimatedBackground"/>
        <Border Padding="28,24" Background="Transparent">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{StaticResource BgCard}"
                        CornerRadius="14"
                        Padding="18,16,18,14"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Padding="2,0"
                                    Background="Transparent"
                                    VerticalAlignment="Top"
                                    Margin="0,0,16,0">
                                <svgc:SvgViewbox x:Name="LogoMellivora"
                                                 Stretch="Uniform"
                                                 Width="128" Height="70"
                                                 Source="pack://application:,,,/svg/mellivora.svg"/>
                            </Border>
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Left">
                                <TextBlock Text="Онлайн сервера"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="#FFE0015B"
                                           HorizontalAlignment="Left"
                                           Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Border Background="#550F0F0F"
                                            CornerRadius="10"
                                            Padding="8,8"
                                            HorizontalAlignment="Left">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Width="28" Height="28"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,6,0">
                                                <svgc:SvgViewbox Stretch="Uniform"
                                                                 Source="pack://application:,,,/svg/detroit.svg"/>
                                            </Border>
                                            <TextBlock x:Name="PlayerCountText"
                                                       Grid.Column="1"
                                                       Text="…"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFE0015B"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,0,6,0"/>
                                            <Grid Grid.Column="2"
                                                  Width="22" Height="22"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,0,0">
                                                <Ellipse x:Name="StatusPingEllipse"
                                                         Width="14" Height="14"
                                                         Fill="#6634D399"
                                                         Opacity="0"
                                                         IsHitTestVisible="False"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"
                                                         RenderTransformOrigin="0.5,0.5">
                                                    <Ellipse.RenderTransform>
                                                        <ScaleTransform x:Name="StatusPingScale" ScaleX="1" ScaleY="1"/>
                                                    </Ellipse.RenderTransform>
                                                </Ellipse>
                                                <Ellipse x:Name="StatusCoreEllipse"
                                                         Width="7" Height="7"
                                                         Fill="#FFEF4444"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Border Background="#550F0F0F"
                                            CornerRadius="10"
                                            Padding="8,8"
                                            Margin="6,0,0,0"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="28" Height="28"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,6,0">
                                                <svgc:SvgViewbox Stretch="Uniform"
                                                                 Source="pack://application:,,,/svg/discordcounter.svg"/>
                                            </Border>
                                            <TextBlock x:Name="DiscordCountText"
                                                       Text="—"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFE0015B"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#550F0F0F"
                                            CornerRadius="10"
                                            Padding="8,8"
                                            Margin="6,0,0,0"
                                            HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="28" Height="28"
                                                    VerticalAlignment="Center"
                                                    Margin="0,0,6,0">
                                                <svgc:SvgViewbox Stretch="Uniform"
                                                                 Source="pack://application:,,,/svg/familycount.svg"/>
                                            </Border>
                                            <TextBlock x:Name="FamilyCountText"
                                                       Text="—"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="#FFE0015B"
                                                       VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <Rectangle Height="1" Fill="#4DE0015B" Margin="0,14,0,0" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </Border>

                <ScrollViewer x:Name="TilesScroll"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0"
                              PanningMode="VerticalOnly">
                    <WrapPanel Orientation="Horizontal"
                               Width="{Binding ViewportWidth, ElementName=TilesScroll}">
                        <Button Style="{StaticResource LaunchTile}"
                                Width="228" MinHeight="118" Margin="0,0,12,12"
                                Tag="Библиотека авто"
                                Click="SectionTile_Click">
                            <StackPanel>
                                <Border Height="48" Margin="0,0,0,10" HorizontalAlignment="Left" Width="48">
                                    <svgc:SvgViewbox Stretch="Uniform" Source="pack://application:,,,/svg/car.svg"/>
                                </Border>
                                <TextBlock Text="Библиотека авто" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource LaunchTile}"
                                Width="228" MinHeight="118" Margin="0,0,12,12"
                                Tag="Библиотека одежды"
                                Click="SectionTile_Click">
                            <StackPanel>
                                <Border Height="48" Margin="0,0,0,10" HorizontalAlignment="Left" Width="48">
                                    <svgc:SvgViewbox Stretch="Uniform" Source="pack://application:,,,/svg/clothes.svg"/>
                                </Border>
                                <TextBlock Text="Библиотека одежды" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource LaunchTile}"
                                Width="228" MinHeight="118" Margin="0,0,12,12"
                                Tag="Список розыгрышей"
                                Click="SectionTile_Click">
                            <StackPanel>
                                <Border Height="48" Margin="0,0,0,10" HorizontalAlignment="Left" Width="48">
                                    <svgc:SvgViewbox Stretch="Uniform" Source="pack://application:,,,/svg/giveaway.svg"/>
                                </Border>
                                <TextBlock Text="Список розыгрышей" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource LaunchTile}"
                                Width="228" MinHeight="118" Margin="0,0,12,12"
                                Tag="Автоматизированные скрипты"
                                Click="SectionTile_Click">
                            <StackPanel>
                                <Border Height="48" Margin="0,0,0,10" HorizontalAlignment="Left" Width="48">
                                    <svgc:SvgViewbox Stretch="Uniform" Source="pack://application:,,,/svg/scripts.svg"/>
                                </Border>
                                <TextBlock Text="Автоматизированные скрипты" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource LaunchTile}"
                                Width="228" MinHeight="118" Margin="0,0,12,12"
                                Tag="Mellivora VPN"
                                Click="SectionTile_Click">
                            <StackPanel>
                                <Border Height="48" Margin="0,0,0,10" HorizontalAlignment="Left" Width="48">
                                    <svgc:SvgViewbox Stretch="Uniform" Source="pack://application:,,,/svg/vpn.svg"/>
                                </Border>
                                <TextBlock Text="Mellivora VPN" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource LaunchTileShazam}"
                                Width="228" MinHeight="118" Margin="0,0,12,12"
                                Tag="Поиск Музыки Shazam"
                                Click="SectionTile_Click"/>

                        <Button Style="{StaticResource LaunchTile}"
                                Width="228" MinHeight="118" Margin="0,0,12,12"
                                Tag="Настройки приложения"
                                Click="SectionTile_Click">
                            <StackPanel>
                                <Border Height="48" Margin="0,0,0,10" HorizontalAlignment="Left" Width="48">
                                    <svgc:SvgViewbox Stretch="Uniform" Source="pack://application:,,,/svg/settings.svg"/>
                                </Border>
                                <TextBlock Text="Настройки приложения" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </ScrollViewer>

                <TextBlock Grid.Row="2" Text="Прокрутите список, если плитки не помещаются." FontSize="12"
                           Foreground="{StaticResource TextMuted}" Margin="0,16,0,0" HorizontalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Вики: WebView2 — отдельное HWND; WPF поверх него после отрисовки не виден. Кнопка только в полосе над WebView. -->
        <Grid x:Name="VehiclesOverlay"
              Visibility="Collapsed"
              Background="#FF1D1D1D"
              Panel.ZIndex="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FF282828"
                    Padding="10,8,10,8"
                    SnapsToDevicePixels="True">
                <Button x:Name="VehiclesHomeButton"
                        Click="VehiclesHomeButton_Click"
                        HorizontalAlignment="Left"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Padding="10,6">
                    <StackPanel Orientation="Horizontal">
                        <svgc:SvgViewbox Width="22"
                                         Height="22"
                                         Source="pack://application:,,,/svg/back.svg"
                                         Stretch="Uniform"/>
                        <TextBlock Text="Домой"
                                   Margin="8,0,4,0"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="#FFF7F7F7"/>
                    </StackPanel>
                </Button>
            </Border>

            <wv2:WebView2 x:Name="VehiclesWebView"
                          Grid.Row="1"/>
        </Grid>

        <Grid x:Name="ClothesOverlay"
              Visibility="Collapsed"
              Background="#FF1D1D1D"
              Panel.ZIndex="40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#FF282828"
                    Padding="10,8,10,8"
                    SnapsToDevicePixels="True">
                <Button x:Name="ClothesHomeButton"
